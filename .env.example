# ── Wompi (pasarela de pagos) ────────────────────────────────────────────────
# Se sacan del panel de Wompi: https://comercios.wompi.co  →  Ajustes → Llaves API.
# Empezá con las de sandbox (pub_test_ / test_integrity_) y cambiá a producción
# cuando el comercio esté aprobado.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXXXXXXXXXX

# URL pública del sitio. En local dejala como está; en producción poné el dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin ────────────────────────────────────────────────────────────────────
# Clave para entrar a /admin y secreto para firmar la cookie de sesión.
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# ── Supabase (base de datos) ─────────────────────────────────────────────────
# Necesario para desplegar en Vercel: allá el sistema de archivos es de solo
# lectura y el admin no podría guardar. En local, si estas variables están
# vacías, el sitio usa los archivos JSON de /data y funciona igual.
# Se sacan de: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# service_role, NO la anon. Es secreta: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXX

# ── Aviso de leads por correo ────────────────────────────────────────────────
# Mientras Cumbre termina de configurar su correo propio (hola@cumbredeco.com
# vía Zoho), los avisos de contacto llegan por Gmail. GMAIL_APP_PASSWORD es
# una contraseña de aplicación (no la contraseña normal de la cuenta): se
# genera en https://myaccount.google.com/apppasswords y requiere tener la
# verificación en dos pasos activada en esa cuenta de Google.
GMAIL_USER=cumbredecohome@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# A quién avisar. Si se omite, se usa la misma cuenta de GMAIL_USER.
LEADS_NOTIFY_TO=cumbredecohome@gmail.com
